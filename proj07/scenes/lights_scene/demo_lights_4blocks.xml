<RT3>
    <!-- ============================================================= -->
    <!-- Reproducao das imagens de referencia do professor a partir de  -->
    <!-- UM unico arquivo, usando varios blocos world_begin/world_end.  -->
    <!-- Cada bloco liga um subconjunto de luzes e grava num filename   -->
    <!-- diferente. A camera e o integrator sao estado global e         -->
    <!-- persistem entre os blocos.                                     -->
    <!--  NÃO TEM GAMMA                                                 -->
    <!-- Gera 4 imagens:                                                -->
    <!--   ambient_light.ppm   (so ambient)                             -->
    <!--   direction_light.ppm (so direcional)                          -->
    <!--   point_light.ppm     (so pontual)                             -->
    <!--   all_light.ppm       (as tres juntas)                         -->
    <!-- A 5a imagem do professor (all_light_shadows) e o proj06.       -->
    <!-- ============================================================= -->

    <lookat look_from="0 4.5 -15" look_at="0 0 1" up="0 1 0" />
    <camera type="perspective" fovy="45" />
    <integrator type="blinn_phong" depth="1" />

    <!-- ===== Bloco 1: SO AMBIENT ===== -->
    <film type="image" w_res="1920" h_res="1200" filename="ambient_light.ppm" img_type="png" />
    <world_begin/>
        <background type="4_colors" bl="176 214 175" tl="4 99 202" tr="4 99 202" br="176 214 175" />

        <light_source type="ambient" I="0.1 0.1 0.1" scale="0.5 0.5 0.5" />

        <make_named_material type="blinn" name="gold"     ambient="0.4 0.4 0.4" diffuse="1 0.65 0.0"  specular="0.8 0.6 0.2" glossiness="256"/>
        <make_named_material type="blinn" name="grey"     ambient="0.1 0.1 0.1" diffuse="0.7 0.7 0.7" specular="0 0 0"       glossiness="0"/>
        <make_named_material type="blinn" name="redish"   ambient="0.6 0.6 0.6" diffuse="0.9 0.2 0.1" specular="0.8 0.8 0.8" glossiness="64"/>
        <make_named_material type="blinn" name="greenish" ambient="0.6 0.6 0.6" diffuse="0.2 0.9 0.2" specular="0.8 0.8 0.8" glossiness="256"/>
        <make_named_material type="blinn" name="blueish"  ambient="0.6 0.6 0.6" diffuse="0.1 0.2 0.9" specular="0.8 0.8 0.8" glossiness="16"/>

        <named_material name="redish"/>   <object type="sphere" center="0 1 0"    radius="1"   />
        <named_material name="greenish"/> <object type="sphere" center="-5 1 4"   radius="1"   />
        <named_material name="blueish"/>  <object type="sphere" center="2 1 5"    radius="1"   />
        <named_material name="gold"/>     <object type="sphere" center="5 3.1 -1" radius="1.3" />
        <named_material name="grey"/>     <object type="sphere" center="0 -5000 0" radius="5000" />
    <world_end/>

    <!-- ===== Bloco 2: SO DIRECIONAL ===== -->
    <film type="image" w_res="1920" h_res="1200" filename="direction_light.ppm" img_type="png" />
    <world_begin/>
        <background type="4_colors" bl="176 214 175" tl="4 99 202" tr="4 99 202" br="176 214 175" />

        <light_source type="directional" I="0.9 0.9 0.9" scale="0.4 0.4 0.4" from="1 0.8 -1" to="0 0 1" />

        <make_named_material type="blinn" name="gold"     ambient="0.4 0.4 0.4" diffuse="1 0.65 0.0"  specular="0.8 0.6 0.2" glossiness="256"/>
        <make_named_material type="blinn" name="grey"     ambient="0.1 0.1 0.1" diffuse="0.7 0.7 0.7" specular="0 0 0"       glossiness="0"/>
        <make_named_material type="blinn" name="redish"   ambient="0.6 0.6 0.6" diffuse="0.9 0.2 0.1" specular="0.8 0.8 0.8" glossiness="64"/>
        <make_named_material type="blinn" name="greenish" ambient="0.6 0.6 0.6" diffuse="0.2 0.9 0.2" specular="0.8 0.8 0.8" glossiness="256"/>
        <make_named_material type="blinn" name="blueish"  ambient="0.6 0.6 0.6" diffuse="0.1 0.2 0.9" specular="0.8 0.8 0.8" glossiness="16"/>

        <named_material name="redish"/>   <object type="sphere" center="0 1 0"    radius="1"   />
        <named_material name="greenish"/> <object type="sphere" center="-5 1 4"   radius="1"   />
        <named_material name="blueish"/>  <object type="sphere" center="2 1 5"    radius="1"   />
        <named_material name="gold"/>     <object type="sphere" center="5 3.1 -1" radius="1.3" />
        <named_material name="grey"/>     <object type="sphere" center="0 -5000 0" radius="5000" />
    <world_end/>

    <!-- ===== Bloco 3: SO PONTUAL ===== -->
    <film type="image" w_res="1920" h_res="1200" filename="point_light.ppm" img_type="png" />
    <world_begin/>
        <background type="4_colors" bl="176 214 175" tl="4 99 202" tr="4 99 202" br="176 214 175" />

        <light_source type="point" I="0.95 0.9 0.8" scale="0.4 0.4 0.4" from="0.1 3.0 1" />

        <make_named_material type="blinn" name="gold"     ambient="0.4 0.4 0.4" diffuse="1 0.65 0.0"  specular="0.8 0.6 0.2" glossiness="256"/>
        <make_named_material type="blinn" name="grey"     ambient="0.1 0.1 0.1" diffuse="0.7 0.7 0.7" specular="0 0 0"       glossiness="0"/>
        <make_named_material type="blinn" name="redish"   ambient="0.6 0.6 0.6" diffuse="0.9 0.2 0.1" specular="0.8 0.8 0.8" glossiness="64"/>
        <make_named_material type="blinn" name="greenish" ambient="0.6 0.6 0.6" diffuse="0.2 0.9 0.2" specular="0.8 0.8 0.8" glossiness="256"/>
        <make_named_material type="blinn" name="blueish"  ambient="0.6 0.6 0.6" diffuse="0.1 0.2 0.9" specular="0.8 0.8 0.8" glossiness="16"/>

        <named_material name="redish"/>   <object type="sphere" center="0 1 0"    radius="1"   />
        <named_material name="greenish"/> <object type="sphere" center="-5 1 4"   radius="1"   />
        <named_material name="blueish"/>  <object type="sphere" center="2 1 5"    radius="1"   />
        <named_material name="gold"/>     <object type="sphere" center="5 3.1 -1" radius="1.3" />
        <named_material name="grey"/>     <object type="sphere" center="0 -5000 0" radius="5000" />
    <world_end/>

    <!-- ===== Bloco 4: TODAS AS LUZES ===== -->
    <film type="image" w_res="1920" h_res="1200" filename="all_light.ppm" img_type="png" />
    <world_begin/>
        <background type="4_colors" bl="176 214 175" tl="4 99 202" tr="4 99 202" br="176 214 175" />

        <light_source type="ambient"     I="0.1 0.1 0.1"  scale="0.5 0.5 0.5" />
        <light_source type="directional" I="0.9 0.9 0.9"  scale="0.4 0.4 0.4" from="1 0.8 -1" to="0 0 1" />
        <light_source type="point"       I="0.95 0.9 0.8" scale="0.4 0.4 0.4" from="0.1 3.0 1" />

        <make_named_material type="blinn" name="gold"     ambient="0.4 0.4 0.4" diffuse="1 0.65 0.0"  specular="0.8 0.6 0.2" glossiness="256"/>
        <make_named_material type="blinn" name="grey"     ambient="0.1 0.1 0.1" diffuse="0.7 0.7 0.7" specular="0 0 0"       glossiness="0"/>
        <make_named_material type="blinn" name="redish"   ambient="0.6 0.6 0.6" diffuse="0.9 0.2 0.1" specular="0.8 0.8 0.8" glossiness="64"/>
        <make_named_material type="blinn" name="greenish" ambient="0.6 0.6 0.6" diffuse="0.2 0.9 0.2" specular="0.8 0.8 0.8" glossiness="256"/>
        <make_named_material type="blinn" name="blueish"  ambient="0.6 0.6 0.6" diffuse="0.1 0.2 0.9" specular="0.8 0.8 0.8" glossiness="16"/>

        <named_material name="redish"/>   <object type="sphere" center="0 1 0"    radius="1"   />
        <named_material name="greenish"/> <object type="sphere" center="-5 1 4"   radius="1"   />
        <named_material name="blueish"/>  <object type="sphere" center="2 1 5"    radius="1"   />
        <named_material name="gold"/>     <object type="sphere" center="5 3.1 -1" radius="1.3" />
        <named_material name="grey"/>     <object type="sphere" center="0 -5000 0" radius="5000" />
    <world_end/>
</RT3>
