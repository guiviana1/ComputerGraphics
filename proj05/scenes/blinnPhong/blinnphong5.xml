<RT3>
    <!-- Cena 4: Três luzes coloridas (RGB) -->
    <!-- Clássico da computação gráfica: 3 luzes pontuais vermelha, verde e azul -->
    <!-- As sombras se misturam e revelam cores secundárias (ciano, magenta, amarelo) -->
    <lookat look_from="0 4 -7" look_at="0 0 0" up="0 1 0" />
    <camera type="perspective" fovy="52" />
    <integrator type="blinnphong" />
    <film type="image" x_res="800" y_res="600" filename="rgb_lights.ppm" />

    <world_begin/>

        <background type="single_color" color="0.02 0.02 0.02" />

        <!-- Ambient muito baixa para as luzes coloridas dominarem -->
        <light_source type="ambient" I="0.05 0.05 0.05" scale="1 1 1" />

        <!-- Luz vermelha: vinda da esquerda -->
        <light_source type="point"
                      I="1.0 0.0 0.0"
                      scale="1.0 1.0 1.0"
                      from="-4 3 -1" />

        <!-- Luz verde: vinda da direita -->
        <light_source type="point"
                      I="0.0 1.0 0.0"
                      scale="1.0 1.0 1.0"
                      from="4 3 -1" />

        <!-- Luz azul: vinda do centro-alto -->
        <light_source type="point"
                      I="0.0 0.0 1.0"
                      scale="1.0 1.0 1.0"
                      from="0 5 -3" />

        <!-- Material branco neutro: deixa as luzes coloridas aparecerem sem interferência -->
        <!-- Se o diffuse fosse colorido, filtraria as luzes e perderia o efeito RGB -->
        <make_named_material type="blinn" name="white_diffuse"
            ambient="0.08 0.08 0.08"
            diffuse="0.85 0.85 0.85"
            specular="0.6 0.6 0.6"
            glossiness="64" />

        <!-- Esfera central: recebe as 3 luzes, mostra mistura no topo -->
        <object type="sphere" radius="1.0" center="0.0 0.0 0.0" material="white_diffuse" />

        <!-- Esferas menores ao redor: cada uma mais perto de uma das luzes -->
        <object type="sphere" radius="0.45" center="-2.0  0.0  0.5" material="white_diffuse" />
        <object type="sphere" radius="0.45" center=" 2.0  0.0  0.5" material="white_diffuse" />
        <object type="sphere" radius="0.45" center=" 0.0  1.8  0.0" material="white_diffuse" />

        <!-- Chão branco para revelar a mistura das luzes coloridas -->
        <make_named_material type="blinn" name="white_floor"
            ambient="0.05 0.05 0.05"
            diffuse="0.75 0.75 0.75"
            specular="0.2 0.2 0.2"
            glossiness="16" />
        <object type="sphere" radius="20.0" center="0.0 -21.0 0.0" material="white_floor" />

    <world_end/>
</RT3>