<RT3>
    <!-- Cena 1: Sistema solar simplificado -->
    <!-- Uma luz pontual central simulando o sol, planetas ao redor -->
    <lookat look_from="0 8 -12" look_at="0 0 0" up="0 1 0" />
    <camera type="perspective" fovy="55" />
    <integrator type="blinnphong" />
    <film type="image" x_res="800" y_res="600" filename="solar_system.ppm" />

    <world_begin/>

        <background type="single_color" color="0.0 0.0 0.02" />

        <!-- Ambient quase zero: espaço é escuro -->
        <light_source type="ambient" I="0.03 0.03 0.03" scale="1 1 1" />

        <!-- O "sol": luz pontual forte no centro -->
        <light_source type="point"
                      I="1.0 0.95 0.8"
                      scale="1.0 1.0 1.0"
                      from="0 0 0" />

        <!-- Sol: esfera amarela grande no centro -->
        <!-- diffuse amarelo intenso, specular brilhante, glossiness alto -->
        <make_named_material type="blinn" name="sun"
            ambient="0.8 0.6 0.0"
            diffuse="1.0 0.85 0.1"
            specular="1.0 0.9 0.3"
            glossiness="8" />

        <!-- Mercúrio: cinza rochoso, fosco -->
        <make_named_material type="blinn" name="mercury"
            ambient="0.05 0.04 0.04"
            diffuse="0.55 0.50 0.48"
            specular="0.1 0.1 0.1"
            glossiness="8" />

        <!-- Venus: amarelo-alaranjado com leve brilho -->
        <make_named_material type="blinn" name="venus"
            ambient="0.06 0.05 0.02"
            diffuse="0.85 0.72 0.35"
            specular="0.3 0.25 0.1"
            glossiness="16" />

        <!-- Terra: azul com leve verde, brilho oceânico -->
        <make_named_material type="blinn" name="earth"
            ambient="0.02 0.04 0.07"
            diffuse="0.15 0.35 0.75"
            specular="0.5 0.5 0.6"
            glossiness="64" />

        <!-- Marte: vermelho-alaranjado, fosco -->
        <make_named_material type="blinn" name="mars"
            ambient="0.06 0.02 0.01"
            diffuse="0.78 0.28 0.10"
            specular="0.15 0.08 0.05"
            glossiness="8" />

        <!-- Objetos -->
        <object type="sphere" radius="1.2"  center="0.0  0.0  0.0"  material="sun"     />
        <object type="sphere" radius="0.18" center="2.2  0.0  0.0"  material="mercury" />
        <object type="sphere" radius="0.30" center="3.5  0.3  0.5"  material="venus"   />
        <object type="sphere" radius="0.32" center="-4.8 0.0  0.8"  material="earth"   />
        <object type="sphere" radius="0.22" center="5.8  -0.2 -0.5" material="mars"    />

    <world_end/>
</RT3>