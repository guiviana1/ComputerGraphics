<RT3>
    <!-- Demo de reflexao perfeita (espelho). Gera 2 imagens, variando o
         max_depth do integrator, para mostrar o efeito da recursao. -->

    <lookat look_from="0 2.5 -9" look_at="0 0.6 0" up="0 1 0" />
    <camera type="perspective" fovy="50" />

    <!-- ===== Sem reflexao (depth = 0) ===== -->
    <integrator type="blinn_phong" depth="0" />
    <film type="image" w_res="800" h_res="600" filename="mirror_d0.ppm" img_type="png" gamma_corrected="true" />

    <world_begin/>
        <background type="4_colors" bl="180 200 230" tl="40 90 200" tr="40 90 200" br="180 200 230" />

        <light_source type="ambient"     I="0.2 0.2 0.2" scale="1 1 1" />
        <light_source type="directional" I="0.9 0.9 0.9" scale="0.6 0.6 0.6" from="-2 4 -3" to="0 0 0" />
        <light_source type="point"       I="0.8 0.8 0.8" scale="0.6 0.6 0.6" from="3 4 -4" />

        <!-- chao levemente espelhado -->
        <make_named_material type="blinn" name="floor"
            ambient="0.1 0.1 0.1" diffuse="0.4 0.4 0.45" specular="0.2 0.2 0.2"
            glossiness="32" mirror="0.35 0.35 0.35" />

        <!-- esfera central: espelho quase perfeito -->
        <make_named_material type="blinn" name="mirror_ball"
            ambient="0.05 0.05 0.05" diffuse="0.1 0.1 0.1" specular="0.9 0.9 0.9"
            glossiness="256" mirror="0.9 0.9 0.9" />

        <make_named_material type="blinn" name="red"
            ambient="0.1 0.02 0.02" diffuse="0.9 0.15 0.15" specular="0.5 0.5 0.5" glossiness="64" />
        <make_named_material type="blinn" name="green"
            ambient="0.02 0.1 0.02" diffuse="0.15 0.85 0.2" specular="0.5 0.5 0.5" glossiness="64" />
        <make_named_material type="blinn" name="blue"
            ambient="0.02 0.02 0.1" diffuse="0.2 0.3 0.9" specular="0.5 0.5 0.5" glossiness="64" />

        <!-- chao (esfera gigante) -->
        <object type="sphere" center="0 -1000 0" radius="1000" material="floor" />

        <!-- esfera espelho no centro -->
        <object type="sphere" center="0 0.8 0" radius="1.4" material="mirror_ball" />

        <!-- esferas coloridas ao redor, para aparecerem no reflexo -->
        <object type="sphere" center="-3 0.6 0.5" radius="0.8" material="red" />
        <object type="sphere" center="3 0.6 0.5"  radius="0.8" material="green" />
        <object type="sphere" center="0 0.5 3.5"  radius="0.7" material="blue" />
    <world_end/>

    <!-- ===== Com reflexao (depth = 3) ===== -->
    <integrator type="blinn_phong" depth="3" />
    <film type="image" w_res="800" h_res="600" filename="mirror_d3.ppm" img_type="png" gamma_corrected="true" />
    <render_again />
</RT3>
