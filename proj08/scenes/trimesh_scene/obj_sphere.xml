<RT3>
    <!-- Carrega uma malha de um arquivo .obj (esfera UV de 768 triangulos).
         Demonstra o leitor de .obj e a interpolacao de normais (Phong shading):
         a esfera deve parecer LISA, apesar de ser feita de triangulos. -->

    <lookat look_from="0 1.5 -5" look_at="0 0 0" up="0 1 0" />
    <camera type="perspective" fovy="45" />
    <integrator type="blinn_phong" depth="1" />
    <film type="image" w_res="800" h_res="600" filename="obj_sphere.ppm" img_type="png" gamma_corrected="true" />

    <world_begin/>
        <background type="4_colors" bl="180 200 230" tl="40 90 200" tr="40 90 200" br="180 200 230" />

        <light_source type="ambient"     I="0.2 0.2 0.2" scale="1 1 1" />
        <light_source type="directional" I="0.9 0.9 0.9" scale="0.7 0.7 0.7" from="-2 3 -3" to="0 0 0" world_radius="60" />
        <light_source type="point"       I="0.6 0.6 0.6" scale="0.7 0.7 0.7" from="3 4 -3" />

        <make_named_material type="blinn" name="floor"
            ambient="0.1 0.1 0.1" diffuse="0.6 0.6 0.65" specular="0.1 0.1 0.1" glossiness="16" />
        <make_named_material type="blinn" name="copper"
            ambient="0.2 0.1 0.05" diffuse="0.85 0.45 0.2" specular="0.9 0.7 0.5" glossiness="128" />

        <!-- chao (esfera gigante) -->
        <object type="sphere" center="0 -1001 0" radius="1000" material="floor" />

        <!-- a malha .obj, com material cobre -->
        <named_material name="copper"/>
        <object type="trianglemesh" filename="data/sphere.obj"
                compute_normals="false" backface_cull="false" />
    <world_end/>
</RT3>
